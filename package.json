{
  "name": "pos-personal-operating-system",
  "private": true,
  "version": "3.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "zip": "node scripts/zip.js",
    "android:sync": "node scripts/ensure-android.mjs",
    "android:build": "npm run android:prepare && cd android && gradlew.bat assembleDebug",
    "android:install": "npm run android:build && \"%LOCALAPPDATA%\\Android\\Sdk\\platform-tools\\adb.exe\" install -r android\\app\\build\\outputs\\apk\\debug\\app-debug.apk",
    "android:prepare": "npm run build && node scripts/ensure-android.mjs",
    "android:clean": "cd android && gradlew.bat clean"
  },
  "dependencies": {
    "@apex/nexus-native": "file:plugins/nexus-native",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capgo/capacitor-speech-recognition": "^8.3.2",
    "framer-motion": "^11.3.0",
    "gsap": "^3.12.5",
    "lenis": "^1.1.14",
    "lucide-react": "^0.439.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "jszip": "^3.10.1",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.2"
  },
  "engines": {
    "node": ">=22"
  }
}
